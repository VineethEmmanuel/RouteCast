# RouteCast - Weather-Aware Truck Routing Platform Environment Variables

# Public Mapbox Access Token (used by Mapbox GL JS on frontend)
# Obtain from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Mapbox Secret / Server Access Token (optional, used by server-side routing & geocoding)
MAPBOX_SECRET_TOKEN=

# Open-Meteo: No API key required for standard non-commercial use!
